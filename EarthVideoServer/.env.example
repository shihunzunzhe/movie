# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=earthvideo

# Collection (scraping) Configuration
# Set COLLECTION_ENABLED=false to disable all scheduled data collection
COLLECTION_ENABLED=true
SCRAPE_INTERVAL=7200
SYNC_INTERVAL=600
DETAIL_FETCH_LIMIT=500
DETAIL_CONCURRENCY=8

# HTTP Proxy for scraping Chinese websites
# US servers need a proxy to access Chinese sites (yutuzy10.com, 5o5k.com).
# Leave empty for direct connection (China mainland server).
# Example: PROXY_URL=http://127.0.0.1:7897
PROXY_URL=
